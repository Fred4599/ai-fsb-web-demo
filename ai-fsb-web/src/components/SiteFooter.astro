---
import { site } from "../content/site";
---

<footer class="bg-white border-slate-200 border-t pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-12 lg:gap-8 mb-16">
      <div class="lg:col-span-2 flex flex-col gap-6 gap-x-6 gap-y-6">
        <a href="#" class="flex items-center group w-fit">
          <span class="font-serif text-xl font-medium text-slate-900 tracking-tight">{site.shortName}</span>
        </a>
        <p class="text-sm text-slate-500 leading-relaxed max-w-sm">
          {site.name}: AI assistant, reviews, missed-call capture, and CRM—without the tech headaches.
        </p>
        <form class="flex gap-2 max-w-sm mt-2" action="#" method="post">
          <input
            type="email"
            name="email"
            placeholder="Email for updates"
            class="flex-1 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-1 focus:ring-[#5B58F6] focus:border-[#5B58F6] transition-all"
          />
          <button type="button" class="bg-[#5B58F6] hover:bg-[#4a47e6] text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
            Join
          </button>
        </form>
      </div>

      <div class="hidden lg:block lg:col-span-1"></div>

      <div>
        <h3 class="text-sm font-medium text-slate-900 mb-4">Services</h3>
        <ul class="space-y-3">
          <li><a href="#services" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">Automation</a></li>
          <li><a href="#solutions" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">Systems</a></li>
          <li><a href="#pricing" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">Pricing</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-medium text-slate-900 mb-4">Company</h3>
        <ul class="space-y-3">
          <li><a href="#studio" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">Studio</a></li>
          <li>
            <a href={`mailto:${site.contact.email}`} class="text-sm text-slate-500 hover:text-slate-900 transition-colors">Contact</a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-medium text-slate-900 mb-4">Connect</h3>
        <ul class="space-y-3">
          <li>
            <a href={`tel:${site.contact.phoneTel}`} class="text-sm text-slate-500 hover:text-slate-900 transition-colors">{site.contact.phone}</a>
          </li>
          <li>
            <a href={`mailto:${site.contact.email}`} class="text-sm text-slate-500 hover:text-slate-900 transition-colors">{site.contact.email}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-slate-200 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex flex-col md:flex-row items-center gap-4 md:gap-6 text-center md:text-left">
        <p class="text-sm text-slate-500">© Copyright {site.year} - {site.name} | All rights reserved.</p>
        <div class="flex items-center gap-4 md:border-l md:border-slate-200 md:pl-6">
          <span class="text-sm text-slate-500">Privacy &amp; terms available on request</span>
        </div>
      </div>
    </div>
  </div>
</footer>
