---
---

<section class="overflow-hidden bg-[#FAFAFA] border-slate-100 border-b pt-16 pb-32 relative">
  <div class="z-10 text-center max-w-7xl mr-auto ml-auto pr-6 pl-6 relative">
    <p class="text-sm text-slate-500 font-medium mb-12 tracking-widest uppercase">
      Trusted by contractors &amp; local teams
    </p>

    <div class="relative w-full max-w-6xl mx-auto">
      <div class="bg-white border border-slate-200 rounded-[28px] overflow-hidden shadow-sm">
        <div class="grid grid-cols-2 md:grid-cols-4 bg-slate-100 gap-[1px]">
          <!-- Block 1 -->
          <div class="logo-hover-block h-32 md:h-40 relative bg-white overflow-hidden cursor-pointer group">
            <div
              class="logo-stack absolute left-0 top-0 w-full h-[200%] transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-y-[-50%]"
            >
              <div
                class="h-1/2 flex items-center justify-center p-6 bg-white group-hover:bg-slate-50 transition-colors duration-300"
              >
                <div
                  class="flex items-center justify-center gap-3 text-slate-400 group-hover:text-slate-900 transition-all duration-300 group-hover:scale-105"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="28"
                    height="28"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
                  </svg>
                  <span class="text-[22px] md:text-[24px] font-medium tracking-tight">Vertex</span>
                </div>
              </div>
              <div class="h-1/2 flex items-center justify-center p-6 bg-slate-50">
                <div class="flex items-center justify-center gap-3 text-slate-900">
                  <span class="text-[22px] md:text-[24px] font-medium tracking-tight">Trades</span>
                </div>
              </div>
            </div>
          </div>
          <!-- Block 2 -->
          <div class="logo-hover-block h-32 md:h-40 relative bg-white overflow-hidden cursor-pointer group">
            <div
              class="logo-stack absolute left-0 top-0 w-full h-[200%] transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-y-[-50%]"
            >
              <div
                class="h-1/2 flex items-center justify-center p-6 bg-white group-hover:bg-slate-50 transition-colors duration-300"
              >
                <div
                  class="flex items-center justify-center gap-3 text-slate-400 group-hover:text-slate-900 transition-all duration-300 group-hover:scale-105"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="28"
                    height="28"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
                    ></path>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                    <line x1="12" y1="22.08" x2="12" y2="12"></line>
                  </svg>
                  <span class="text-[22px] md:text-[24px] font-medium tracking-tight">Nexus</span>
                </div>
              </div>
              <div class="h-1/2 flex items-center justify-center p-6 bg-slate-50">
                <div class="flex items-center justify-center gap-3 text-slate-900">
                  <span class="text-[22px] md:text-[24px] font-medium tracking-tight">Service pros</span>
                </div>
              </div>
            </div>
          </div>
          <!-- Block 3 -->
          <div class="logo-hover-block h-32 md:h-40 relative bg-white overflow-hidden cursor-pointer group">
            <div
              class="logo-stack absolute left-0 top-0 w-full h-[200%] transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-y-[-50%]"
            >
              <div
                class="h-1/2 flex items-center justify-center p-6 bg-white group-hover:bg-slate-50 transition-colors duration-300"
              >
                <div
                  class="flex items-center justify-center gap-3 text-slate-400 group-hover:text-slate-900 transition-all duration-300 group-hover:scale-105"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="28"
                    height="28"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                    <path d="M3 9h18"></path>
                    <path d="M9 21V9"></path>
                  </svg>
                  <span class="text-[22px] md:text-[24px] font-medium tracking-tight">Quantum</span>
                </div>
              </div>
              <div class="h-1/2 flex items-center justify-center p-6 bg-slate-50">
                <div class="flex items-center justify-center gap-3 text-slate-900">
                  <span class="text-[22px] md:text-[24px] font-medium tracking-tight">Home services</span>
                </div>
              </div>
            </div>
          </div>
          <!-- Block 4 -->
          <div class="logo-hover-block h-32 md:h-40 relative bg-white overflow-hidden cursor-pointer group">
            <div
              class="logo-stack absolute left-0 top-0 w-full h-[200%] transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-y-[-50%]"
            >
              <div
                class="h-1/2 flex items-center justify-center p-6 bg-white group-hover:bg-slate-50 transition-colors duration-300"
              >
                <div
                  class="flex items-center justify-center gap-3 text-slate-400 group-hover:text-slate-900 transition-all duration-300 group-hover:scale-105"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="28"
                    height="28"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                  </svg>
                  <span class="text-[22px] md:text-[24px] font-medium tracking-tight">Echo</span>
                </div>
              </div>
              <div class="h-1/2 flex items-center justify-center p-6 bg-slate-50">
                <div class="flex items-center justify-center gap-3 text-slate-900">
                  <span class="text-[22px] md:text-[24px] font-medium tracking-tight">Local crews</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
