---
import { site } from "../content/site";

const tiers = site.pricingTiers;
---

<section
  id="pricing"
  class="min-h-screen flex lg:p-12 antialiased overflow-x-hidden text-slate-900 bg-slate-50 pt-6 pr-6 pb-6 pl-6 items-center justify-center"
  style="font-family: 'Inter', sans-serif; background-image: radial-gradient(#d8d4fe 1px, transparent 1px); background-size: 40px 40px; background-position: center center"
>
  <main class="max-w-6xl w-full mx-auto flex flex-col gap-16 relative z-10 my-10">
    <header class="flex flex-col gap-10 z-20 text-center relative gap-x-10 gap-y-10 items-center">
      <div class="space-y-6 flex flex-col items-center">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-violet-50/90 border border-violet-200/60 text-violet-700 text-xs font-medium tracking-wide shadow-sm backdrop-blur-md"
        >
          <iconify-icon icon="solar:pie-chart-2-linear" class="text-base"></iconify-icon>
          Transparent pricing
        </div>
        <h1 class="text-4xl lg:text-6xl font-medium tracking-tight leading-tight max-w-2xl text-slate-900">
          Predictable <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-500 to-purple-600">economics</span>
        </h1>
        <p class="text-base lg:text-lg text-slate-500 font-normal max-w-xl leading-relaxed">
          Three tiers for contractors. Toggle to compare recurring monthly billing vs. estimated first-year investment (setup
          + 12 months).
        </p>
      </div>

      <div
        id="toggle-container"
        role="switch"
        aria-checked="false"
        tabindex="0"
        class="relative z-10 w-[260px] h-16 rounded-full p-1.5 flex items-center cursor-pointer group transition-all duration-500 outline-none focus-visible:ring-4 focus-visible:ring-violet-500/30 overflow-hidden"
        style="background: repeating-linear-gradient(90deg, transparent, transparent 2px, rgba(0, 0, 0, 0.02) 2px, rgba(0, 0, 0, 0.02) 4px), linear-gradient(rgb(248, 250, 252) 0%, rgb(226, 232, 240) 100%); box-shadow: rgba(0, 0, 0, 0.04) 2px 2px 0px, rgba(0, 0, 0, 0.03) 4px 4px 0px, rgba(0, 0, 0, 0.02) 6px 6px 0px, rgba(0, 0, 0, 0.01) 8px 8px 0px, rgba(0, 0, 0, 0.01) 10px 10px 0px, rgba(0, 0, 0, 0.1) 20px 20px 30px, rgba(0, 0, 0, 0.05) 0px 4px 8px inset, rgba(255, 255, 255, 0.7) 0px -2px 4px inset, rgba(248, 250, 252, 0.8) 0px 0px 0px 6px; border: 1px solid rgb(203, 213, 225);"
      >
        <div class="absolute inset-0 flex items-center justify-between px-7 pointer-events-none select-none">
          <span id="label-monthly" class="text-[17px] font-medium transition-colors duration-300 text-slate-900">Monthly</span>
          <span id="label-yearly" class="text-[17px] font-medium transition-colors duration-300 text-slate-500">First year</span>
        </div>
        <div
          id="toggle-thumb"
          class="absolute top-[6px] left-[6px] h-[52px] w-[146px] rounded-full flex items-center justify-center gap-3 px-5 whitespace-nowrap"
          style="will-change: left; background: linear-gradient(rgb(255, 255, 255) 0%, rgb(248, 250, 252) 100%); box-shadow: rgba(0, 0, 0, 0.1) 1px 1px 0px, rgba(0, 0, 0, 0.08) 2px 2px 0px, rgba(0, 0, 0, 0.06) 3px 3px 0px, rgba(0, 0, 0, 0.04) 4px 4px 0px, rgba(0, 0, 0, 0.02) 5px 5px 0px, rgba(0, 0, 0, 0.15) 12px 12px 20px -4px, rgb(255, 255, 255) 0px 3px 4px inset, rgba(0, 0, 0, 0.05) 0px -2px 4px inset; border: 1px solid rgb(226, 232, 240); left: 6px;"
        >
          <iconify-icon id="toggle-icon" icon="solar:wallet-money-linear" class="text-[22px] shrink-0 drop-shadow-sm transition-colors duration-300 text-slate-500"
          ></iconify-icon>
          <span id="toggle-text" class="text-[17px] font-medium text-slate-800 tracking-[0.01em] transition-all duration-300" style="text-shadow: 0 1px 1px rgba(255,255,255,0.9);"
            >Monthly</span
          >
        </div>
      </div>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative z-20 items-stretch max-w-5xl mx-auto w-full">
      {
        tiers.map((tier) =>
          tier.popular ? (
            <div class="relative flex flex-col transition-all duration-300 hover:-translate-y-2">
              <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-violet-400/20 blur-[80px] rounded-full pointer-events-none z-0 transition-opacity duration-300" />
              <div class="bg-white rounded-[24px] p-8 shadow-xl shadow-violet-900/5 border border-violet-100 flex flex-col gap-8 relative z-10 flex-1 ring-1 ring-violet-500/20">
                <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-gradient-to-r from-violet-500 to-purple-500 text-white text-xs px-4 py-1.5 rounded-full font-medium tracking-wide shadow-md flex items-center gap-2">
                  <span class="flex h-1.5 w-1.5 relative">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-violet-200 opacity-75" />
                    <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-white" />
                  </span>
                  {tier.badge}
                </div>
                <div>
                  <div
                    class="w-12 h-12 rounded-xl flex items-center justify-center mb-6"
                    style="background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); box-shadow: inset 0 2px 2px rgba(255,255,255,0.3), inset 0 -2px 4px rgba(0,0,0,0.15), 0 4px 12px -2px rgba(139,92,246,0.4); border: 1px solid #7c3aed;"
                  >
                    <iconify-icon icon="solar:bolt-linear" class="text-white text-2xl drop-shadow-sm" />
                  </div>
                  <h3 class="text-xl font-medium tracking-tight text-slate-900 mb-1">{tier.name}</h3>
                  <p class="text-sm text-violet-600 font-normal mb-1">{tier.blurb}</p>
                  <p class="text-xs text-slate-500">
                    Setup <span class="font-medium text-slate-700">${tier.setup}</span>
                  </p>
                </div>
                <div class="flex items-baseline gap-1">
                  <span
                    class="text-5xl font-medium tracking-tight text-slate-900 price-val"
                    data-monthly={String(tier.monthly)}
                    data-yearly={String(tier.firstYear)}
                    style='font-family: "JetBrains Mono", monospace; transition: opacity 0.2s, transform 0.2s;'
                  >
                    ${tier.monthly}
                  </span>
                  <span class="text-sm text-slate-500 font-normal price-suffix">/mo</span>
                </div>
                <ul class="flex flex-col gap-4 text-sm font-normal text-slate-600 flex-1">
                  {tier.features.map((f) => (
                    <li class="flex items-start gap-3">
                      <iconify-icon icon="solar:check-circle-linear" class="text-purple-500 text-xl shrink-0" />
                      {f}
                    </li>
                  ))}
                </ul>
                <a
                  href={`tel:${site.contact.phoneTel}`}
                  class="transition-all duration-200 hover:shadow-lg hover:shadow-violet-500/25 active:scale-[0.98] text-sm font-medium text-white w-full rounded-xl pt-3.5 pb-3.5 text-center"
                  style="background: linear-gradient(180deg, #8b5cf6 0%, #7c3aed 100%); box-shadow: inset 0 1px 1px rgba(255,255,255,0.3), 0 4px 10px -2px rgba(139,92,246,0.3); border: 1px solid #6d28d9"
                >
                  Talk to Jack
                </a>
              </div>
            </div>
          ) : (
            <div class="bg-white/80 backdrop-blur-sm rounded-[24px] p-8 shadow-sm hover:shadow-xl hover:shadow-slate-200/50 border border-slate-200 hover:border-violet-200/50 flex flex-col gap-8 transition-all duration-300 hover:-translate-y-2 group">
              <div>
                <div class="w-12 h-12 rounded-xl flex items-center justify-center bg-slate-50 text-slate-600 border border-slate-200 shadow-inner mb-6 group-hover:bg-violet-50 group-hover:text-violet-600 group-hover:border-violet-100 transition-colors duration-300">
                  <iconify-icon
                    icon={tier.id === "foundation" ? "solar:shield-minimalistic-linear" : "solar:global-linear"}
                    class="text-2xl"
                  />
                </div>
                <h3 class="text-xl font-medium tracking-tight text-slate-900 mb-1">{tier.name}</h3>
                <p class="text-sm text-slate-500 font-normal mb-1">{tier.blurb}</p>
                <p class="text-xs text-slate-500">
                  Setup <span class="font-medium text-slate-700">${tier.setup}</span>
                </p>
              </div>
              <div class="flex items-baseline gap-1">
                <span
                  class="text-4xl font-medium tracking-tight text-slate-900 price-val"
                  data-monthly={String(tier.monthly)}
                  data-yearly={String(tier.firstYear)}
                  style='font-family: "JetBrains Mono", monospace; transition: opacity 0.2s, transform 0.2s;'
                >
                  ${tier.monthly}
                </span>
                <span class="text-sm text-slate-500 font-normal price-suffix">/mo</span>
              </div>
              <ul class="flex flex-col gap-4 text-sm font-normal text-slate-600 flex-1">
                {tier.features.map((f) => (
                  <li class="flex items-start gap-3">
                    <iconify-icon icon="solar:check-circle-linear" class="text-violet-500 text-xl shrink-0" />
                    {f}
                  </li>
                ))}
                {"missing" in tier && tier.missing ? (
                  <li class="flex items-start gap-3 text-slate-400">
                    <iconify-icon icon="solar:close-circle-linear" class="text-slate-300 text-xl shrink-0" />
                    {tier.missing}
                  </li>
                ) : null}
              </ul>
              <a
                href={`tel:${site.contact.phoneTel}`}
                class="w-full py-3.5 rounded-xl border border-slate-200 bg-white text-slate-700 text-sm font-medium hover:bg-slate-50 hover:border-slate-300 hover:text-slate-900 transition-all duration-200 shadow-sm active:scale-[0.98] text-center"
              >
                {tier.id === "dominator" ? "Book a strategy call" : "Start the conversation"}
              </a>
            </div>
          )
        )
      }
    </div>
    <p class="text-center text-xs text-slate-400 max-w-2xl mx-auto">
      *First year estimate = setup fee plus twelve months at the listed monthly rate. Grand opening promos may apply—ask when
      you call.
    </p>
  </main>
</section>

<script>
  import { initPricingToggle } from "../scripts/pricing-toggle";
  initPricingToggle();
</script>
