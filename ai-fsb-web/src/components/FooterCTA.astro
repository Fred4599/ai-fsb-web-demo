---
import { site } from "../content/site";
---

<section
  class="antialiased overflow-hidden selection:bg-indigo-500/30 selection:text-indigo-200 lg:py-32 py-20 text-slate-300 relative bg-[#020617]"
  style="font-family: 'Inter', sans-serif;"
>
  <div class="absolute inset-0 pointer-events-none z-0">
    <div class="absolute -top-[20%] -left-[10%] w-[70%] h-[70%] bg-[radial-gradient(circle_at_center,rgba(99,102,241,0.15),transparent_60%)] blur-[100px]"></div>
    <div class="absolute top-[40%] -right-[20%] w-[60%] h-[60%] bg-[radial-gradient(circle_at_center,rgba(6px,182,212,0.12),transparent_60%)] blur-[100px]"></div>
    <div
      style="background-size:40px 40px; background-image:linear-gradient(to right,rgba(255,255,255,0.03) 1px,transparent 1px), linear-gradient(to bottom,rgba(255,255,255,0.03) 1px,transparent 1px); mask-image:radial-gradient(circle at center,black 40%,transparent 80%); -webkit-mask-image:radial-gradient(circle at center,black 40%,transparent 80%);"
      class="absolute inset-0"
    >
    </div>
  </div>

  <main class="z-10 flex w-full relative items-center justify-center">
    <div class="max-w-[1280px] w-full mx-auto px-6 sm:px-12 grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-12 items-center">
      <div class="flex flex-col items-start space-y-8 max-w-xl relative z-20">
        <div
          class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-300 text-xs font-medium shadow-[0_0_15px_rgba(99,102,241,0.15)] backdrop-blur-md"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 relative flex items-center justify-center">
            <span class="absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75" style="animation: ping 1.5s cubic-bezier(0,0,0.2,1) infinite;"></span>
            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-indigo-500"></span>
          </span>
          Let’s get started
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-[4.5rem] font-medium tracking-tight leading-[1.05] text-white">
          Ready to make a real <br class="hidden sm:block" />
          change? <span
            class="bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 via-cyan-300 to-indigo-400"
            style="background-size: 200% auto; animation: shine 5s linear infinite;">Let’s build it together.</span
          >
        </h1>

        <p class="text-base sm:text-lg text-slate-400 leading-relaxed font-light max-w-[440px]">
          Call Jack for a free conversation—{site.promo.headline.replace("!", "")} ({site.promo.note}).
        </p>

        <div class="flex flex-col sm:flex-row items-center gap-4 pt-2 w-full sm:w-auto">
          <a
            href={`tel:${site.contact.phoneTel}`}
            class="w-full sm:w-auto px-7 py-3.5 rounded-full bg-white text-slate-950 font-medium text-sm flex items-center justify-center gap-2 hover:bg-slate-100 transition-all shadow-[0_0_20px_rgba(255,255,255,0.15)] hover:shadow-[0_0_25px_rgba(255,255,255,0.25)] hover:-translate-y-0.5 active:scale-95 group"
          >
            Call {site.contact.phone}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"
              ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
            >
          </a>
          <a
            href={`mailto:${site.contact.email}`}
            class="w-full sm:w-auto px-7 py-3.5 rounded-full bg-white/5 backdrop-blur-md border border-white/10 text-white font-medium text-sm flex items-center justify-center gap-2 hover:bg-white/10 transition-all hover:-translate-y-0.5 active:scale-95"
          >
            Email Jack
          </a>
        </div>
      </div>

      <div class="relative w-full aspect-square max-w-[600px] mx-auto lg:h-[600px] flex items-center justify-center">
        <div id="webgl-globe-container" class="absolute inset-0 w-full h-full cursor-grab active:cursor-grabbing z-10"></div>

        <div class="absolute inset-0 w-full h-full pointer-events-none z-20 hidden sm:block">
          <div
            class="floating-label absolute top-[15%] left-[5%] bg-slate-900/80 backdrop-blur-md border border-slate-700/50 rounded-full px-4 py-2 text-xs font-medium text-slate-200 shadow-[0_10px_30px_rgba(0,0,0,0.5)] flex items-center gap-2"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-400"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg>
            More calls booked
          </div>
          <div
            class="floating-label absolute top-[28%] right-[0%] bg-slate-900/80 backdrop-blur-md border border-slate-700/50 rounded-full px-4 py-2 text-xs font-medium text-slate-200 shadow-[0_10px_30px_rgba(0,0,0,0.5)] flex items-center gap-2"
            data-offset="1.5"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-cyan-400"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
            Better reviews
          </div>
          <div
            class="floating-label absolute bottom-[22%] left-[2%] bg-slate-900/80 backdrop-blur-md border border-slate-700/50 rounded-full px-4 py-2 text-xs font-medium text-slate-200 shadow-[0_10px_30px_rgba(0,0,0,0.5)] flex items-center gap-2"
            data-offset="3"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-400"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18"></path><path d="M9 21V9"></path></svg>
            Simple systems
          </div>
          <div
            class="floating-label absolute bottom-[12%] right-[8%] bg-slate-900/80 backdrop-blur-md border border-slate-700/50 rounded-full px-4 py-2 text-xs font-medium text-slate-200 shadow-[0_10px_30px_rgba(0,0,0,0.5)] flex items-center gap-2"
            data-offset="4.5"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-cyan-400"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            Clear next steps
          </div>
        </div>
      </div>
    </div>
  </main>
</section>

<script>
  import { initGlobe } from "../scripts/globe";
  initGlobe();
</script>
