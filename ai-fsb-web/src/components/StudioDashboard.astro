---
import { site } from "../content/site";
---

<section
  id="studio"
  class="sm:py-24 lg:py-32 sm:px-6 lg:px-8 antialiased overflow-hidden text-slate-800 w-full max-w-7xl mr-auto ml-auto pt-16 pr-4 pb-16 pl-4"
>
  <div class="flex flex-col lg:flex-row lg:gap-16 lg:items-end lg:mb-20 mb-12 gap-x-8 gap-y-8 items-start">
    <div class="flex-1">
      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-medium tracking-tight text-slate-900 mb-6 leading-[1.1] max-w-2xl">
        Run follow-up, reviews, and campaigns from one place
      </h2>
      <a
        href="#pricing"
        class="inline-flex items-center gap-2 hover:bg-violet-700 transition-colors hover:shadow-md active:scale-95 text-sm font-medium text-white bg-[#5B58F6] rounded-full pt-3.5 pr-6 pb-3.5 pl-6 shadow-sm"
      >
        View pricing
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
    <div class="lg:w-[45%]">
      <p class="text-lg text-slate-500 font-normal leading-relaxed">
        From lead capture to launch readiness, {site.shortName} helps you track builds, approvals, assets, and messaging
        in a single workspace—so nothing falls through the cracks.
      </p>
    </div>
  </div>

  <div
    class="relative w-full rounded-[2rem] mb-16 lg:mb-24 min-h-[620px] sm:min-h-[720px] lg:min-h-[760px] border border-slate-200/60 shadow-sm bg-slate-50 overflow-hidden"
    style="background: radial-gradient(circle at 82% 18%, rgba(191,219,254,0.22) 0%, transparent 36%), radial-gradient(circle at 14% 84%, rgba(168,85,247,0.14) 0%, transparent 36%), linear-gradient(135deg, #f8fafc 0%, #f5f3ff 100%);"
  >
    <div class="absolute -top-[10%] -right-[10%] w-[40%] h-[40%] bg-sky-300/20 blur-[100px] rounded-full pointer-events-none"></div>
    <div class="absolute -bottom-[10%] -left-[10%] w-[40%] h-[40%] bg-violet-400/15 blur-[100px] rounded-full pointer-events-none"></div>

    <div class="min-h-[620px] sm:min-h-[720px] lg:min-h-[760px] overflow-visible w-full h-full relative">
      <div
        class="absolute left-1/2 top-1/2 z-10 w-[92%] max-w-[980px] h-[78%] min-h-[480px] -translate-x-1/2 -translate-y-1/2 bg-slate-50 rounded-[2rem] shadow-[0_30px_60px_-15px_rgba(15,23,42,0.15),inset_0_0_0_1px_rgba(255,255,255,0.9),inset_0_0_0_2px_rgba(226,232,240,0.8)] overflow-hidden ring-1 ring-slate-900/5"
      >
        <div
          class="h-12 border-b border-slate-300/60 bg-gradient-to-b from-white to-slate-100 flex items-center px-5 shadow-[inset_0_1px_0_rgba(255,255,255,1)]"
        >
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-gradient-to-b from-slate-300 to-slate-400 shadow-[inset_0_1px_2px_rgba(0,0,0,0.15),0_1px_0_rgba(255,255,255,1)]"></div>
            <div class="w-3 h-3 rounded-full bg-gradient-to-b from-slate-300 to-slate-400 shadow-[inset_0_1px_2px_rgba(0,0,0,0.15),0_1px_0_rgba(255,255,255,1)]"></div>
            <div class="w-3 h-3 rounded-full bg-gradient-to-b from-slate-300 to-slate-400 shadow-[inset_0_1px_2px_rgba(0,0,0,0.15),0_1px_0_rgba(255,255,255,1)]"></div>
          </div>
          <div class="flex-1 flex justify-center">
            <div
              class="px-4 py-1.5 rounded-full border border-slate-300/60 bg-slate-200/50 min-w-[250px] flex items-center justify-center gap-2 shadow-[inset_0_1px_3px_rgba(0,0,0,0.06),0_1px_0_rgba(255,255,255,1)]"
            >
              <span class="text-[11px] text-slate-500 font-medium tracking-wide">studio.aiforsmall.bz</span>
            </div>
          </div>
          <div class="w-12"></div>
        </div>

        <div class="flex h-[calc(100%-48px)] relative z-0">
          <aside
            class="hidden md:flex w-56 lg:w-64 bg-gradient-to-b from-[#1c103f] to-[#120a2b] shadow-[inset_-1px_0_0_rgba(0,0,0,0.3),inset_1px_0_0_rgba(255,255,255,0.05)] text-white flex-col p-5 relative overflow-hidden"
          >
            <div class="flex items-center gap-3 mb-10 pl-2 relative z-10">
              <span class="text-base font-medium tracking-tight text-white drop-shadow-sm">Client HQ</span>
            </div>
            <nav class="space-y-1.5 text-[13px] font-normal text-white/70 relative z-10">
              <div class="px-4 py-2.5 rounded-lg hover:bg-white/5 hover:text-white cursor-pointer transition-all">Overview</div>
              <div
                class="px-4 py-2.5 rounded-lg bg-gradient-to-b from-white/15 to-white/5 border-t border-white/20 border-b border-black/20 shadow-[0_2px_4px_rgba(0,0,0,0.1),inset_0_1px_0_rgba(255,255,255,0.1)] text-white font-medium flex items-center justify-between"
              >
                Projects
                <div class="w-1.5 h-1.5 rounded-full bg-indigo-400 shadow-[0_0_4px_rgba(129,140,248,0.8)]"></div>
              </div>
              <div class="px-4 py-2.5 rounded-lg hover:bg-white/5 hover:text-white cursor-pointer transition-all">Assets</div>
              <div class="px-4 py-2.5 rounded-lg hover:bg-white/5 hover:text-white cursor-pointer transition-all">Launches</div>
            </nav>
          </aside>

          <div class="flex-1 bg-[#f4f5f7] relative shadow-[inset_0_2px_8px_rgba(0,0,0,0.04)] overflow-hidden">
            <div
              class="absolute inset-0 pointer-events-none bg-[linear-gradient(to_right,#e5e7eb_1px,transparent_1px),linear-gradient(to_bottom,#e5e7eb_1px,transparent_1px)] bg-[size:24px_24px] opacity-40"
            >
            </div>
            <div class="p-6 sm:p-8 h-full overflow-y-auto relative z-10">
              <div class="flex items-end justify-between mb-6">
                <h3 class="text-2xl sm:text-3xl font-medium tracking-tight text-slate-800">Hello, Northstar Remodeling</h3>
              </div>

              <div
                class="bg-gradient-to-b from-white to-slate-50 border border-slate-200 shadow-[0_2px_6px_rgba(15,23,42,0.04),inset_0_1px_0_rgba(255,255,255,1)] p-4 rounded-xl flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6"
              >
                <div>
                  <p class="text-sm font-medium text-slate-800 mb-0.5 tracking-tight">Homepage revision approved</p>
                  <p class="text-xs text-slate-500 leading-relaxed">The hero update is cleared to move into final build.</p>
                </div>
                <button
                  type="button"
                  class="px-4 py-2 bg-gradient-to-b from-white to-slate-100 border border-slate-300 shadow-[0_1px_2px_rgba(0,0,0,0.05),inset_0_1px_0_rgba(255,255,255,1)] rounded-lg text-xs font-medium text-slate-700 whitespace-nowrap"
                >
                  View details
                </button>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-6">
                <div
                  class="bg-gradient-to-b from-white to-[#fafafa] border border-slate-200 shadow-[0_2px_8px_rgba(15,23,42,0.04),inset_0_1px_0_rgba(255,255,255,1)] p-5 rounded-xl"
                >
                  <p class="text-xs text-slate-500 mb-3 font-medium uppercase tracking-wider">Active builds</p>
                  <p class="text-3xl font-medium text-slate-800 tracking-tight">08</p>
                </div>
                <div
                  class="bg-gradient-to-b from-white to-[#fafafa] border border-slate-200 shadow-[0_2px_8px_rgba(15,23,42,0.04),inset_0_1px_0_rgba(255,255,255,1)] p-5 rounded-xl flex flex-col justify-between"
                >
                  <p class="text-xs text-slate-500 font-medium uppercase tracking-wider mb-3">Launch readiness</p>
                  <p class="text-[13px] font-medium text-slate-800 mb-2 leading-snug">Automation flows are 92% ready</p>
                  <div class="studio-progress-track w-full h-2.5 bg-slate-200/80 rounded-full shadow-[inset_0_1px_2px_rgba(0,0,0,0.1),0_1px_0_rgba(255,255,255,1)] mb-3">
                    <div
                      id="studio-progress-fill"
                      class="studio-progress-fill h-full bg-gradient-to-r from-violet-500 to-indigo-400 shadow-[0_0_8px_rgba(139,92,246,0.4)] rounded-full relative"
                      data-target="92%"
                    >
                      <div
                        class="studio-progress-stripes absolute inset-0 bg-[linear-gradient(45deg,rgba(255,255,255,0.15)_25%,transparent_25%,transparent_50%,rgba(255,255,255,0.15)_50%,rgba(255,255,255,0.15)_75%,transparent_75%,transparent)] bg-[length:1rem_1rem] rounded-full"
                      >
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div
        class="hidden lg:block absolute top-[1rem] right-[1.5rem] z-30 w-[260px] bg-white/70 backdrop-blur-xl border border-white shadow-[0_16px_32px_-8px_rgba(15,23,42,0.12),0_0_0_1px_rgba(226,232,240,0.5),inset_0_1px_0_rgba(255,255,255,1)] p-4 rounded-2xl"
        style="animation: studio-float-smooth-reverse 7s ease-in-out infinite;"
      >
        <p class="font-medium text-slate-800 text-[13px] tracking-tight mb-2">Launch checklist</p>
        <p class="text-[11px] text-slate-500 mb-3 leading-relaxed">Track QA, approvals, content polish, and deployment.</p>
        <div
          class="bg-slate-100/80 shadow-[inset_0_2px_4px_rgba(15,23,42,0.05),0_1px_0_rgba(255,255,255,1)] border border-slate-200/60 rounded-lg p-2.5 text-[10px] font-mono text-slate-600"
        >
          studio.create('<span class="text-emerald-600">launch</span>');
        </div>
      </div>

      <div
        class="hidden md:block bg-white/70 w-[260px] z-30 border border-white rounded-2xl p-4 absolute bottom-[2.5rem] left-[2rem] shadow-[0_16px_32px_-8px_rgba(15,23,42,0.12),0_0_0_1px_rgba(226,232,240,0.5),inset_0_1px_0_rgba(255,255,255,1)] backdrop-blur-xl"
        style="animation: studio-float-smooth-reverse 8s ease-in-out infinite;"
      >
        <p class="font-medium text-slate-800 text-[13px] tracking-tight mb-2">Project timeline</p>
        <p class="text-[11px] text-slate-500 mb-3 leading-relaxed">Milestones for campaigns and GMB pushes.</p>
        <div
          class="bg-slate-100/80 shadow-[inset_0_2px_4px_rgba(15,23,42,0.05),0_1px_0_rgba(255,255,255,1)] border border-slate-200/60 rounded-lg p-2.5 text-[10px] font-mono text-slate-600"
        >
          studio.sync('<span class="text-violet-600">timeline</span>');
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initStudioDashboard } from "../scripts/studio-dashboard";
  initStudioDashboard();
</script>
