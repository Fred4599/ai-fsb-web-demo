              <span class="text-slate-500 font-normal">Lead ID</span>
              <span class="font-medium text-slate-900 text-xs tracking-wide">#LEAD-8921</span>
            </div>
            <div
              class="flex justify-between items-center py-2.5 border-t border-slate-200/60 shadow-[inset_0_1px_0_rgba(255,255,255,0.5)]"
