                  >
                  </div>
                  <span class="text-xs uppercase tracking-[0.24em] text-slate-400 font-medium">Live overview</span>
                </div>
                <h2 class="text-[2.15rem] leading-none font-normal text-slate-900 tracking-tight">Active leads</h2>
              </div>

              <div class="text-right">
                <p class="text-xs uppercase tracking-[0.24em] text-slate-400 font-medium mb-2">Pipeline</p>
                <p class="text-2xl font-normal tracking-tight text-slate-900">$84.2K</p>
              </div>
            </div>

            <div class="grid grid-cols-3 gap-4 mb-8">
              <div
                class="rounded-2xl border border-slate-200/60 bg-gradient-to-b from-white to-slate-50/80 px-5 py-4 shadow-[0_3px_8px_rgba(0,0,0,0.03),inset_0_1px_0_rgba(255,255,255,1),inset_0_-1px_1px_rgba(0,0,0,0.02)]"
              >
                <p class="text-[11px] uppercase tracking-[0.18em] text-slate-400 mb-2">Follow-ups</p>
                <p class="text-xl text-slate-900 tracking-tight">$12.4K</p>
              </div>
              <div
                class="rounded-2xl border border-slate-200/60 bg-gradient-to-b from-white to-slate-50/80 px-5 py-4 shadow-[0_3px_8px_rgba(0,0,0,0.03),inset_0_1px_0_rgba(255,255,255,1),inset_0_-1px_1px_rgba(0,0,0,0.02)]"
              >
                <p class="text-[11px] uppercase tracking-[0.18em] text-slate-400 mb-2">Booked</p>
                <p class="text-xl text-slate-900 tracking-tight">24 today</p>
              </div>
              <div
                class="rounded-2xl border border-slate-200/60 bg-gradient-to-b from-white to-slate-50/80 px-5 py-4 shadow-[0_3px_8px_rgba(0,0,0,0.03),inset_0_1px_0_rgba(255,255,255,1),inset_0_-1px_1px_rgba(0,0,0,0.02)]"
              >
                <p class="text-[11px] uppercase tracking-[0.18em] text-slate-400 mb-2">Territories</p>
                <p class="text-xl text-slate-900 tracking-tight">4 zones</p>
              </div>
            </div>

            <div
              class="rounded-[1.75rem] border border-slate-200/60 bg-gradient-to-b from-white to-slate-50/30 overflow-hidden shadow-[0_4px_12px_rgba(0,0,0,0.03),inset_0_1px_0_rgba(255,255,255,1)]"
            >
              <div
                class="grid grid-cols-12 gap-4 px-6 py-4 text-[11px] uppercase tracking-[0.18em] text-slate-400 border-b border-slate-200/60 bg-slate-100/50 shadow-[inset_0_1px_0_rgba(255,255,255,0.5)]"
              >
                <div class="col-span-5">Customer</div>
                <div class="col-span-3">Area</div>
                <div class="col-span-2 text-right">Jobs</div>
                <div class="col-span-2 text-right">LTV</div>
              </div>

              <div
                class="grid grid-cols-12 gap-4 px-6 py-5 items-center bg-[#5B58F6]/[0.02] hover:bg-[#5B58F6]/[0.05] transition-colors border-b border-slate-100/80"
              >
                <div class="col-span-5 flex items-center gap-3">
                  <div
                    class="w-11 h-11 rounded-full bg-gradient-to-b from-amber-50 to-amber-100/60 border border-amber-200/50 flex items-center justify-center text-amber-600 shadow-[inset_0_2px_4px_rgba(255,255,255,0.9),0_2px_4px_rgba(0,0,0,0.04),inset_0_-1px_1px_rgba(0,0,0,0.05)]"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="w-5 h-5"
                    >
                      <path
                        d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <p class="text-slate-900 text-[1.45rem] leading-none tracking-tight">Northstar</p>
                    <p class="text-sm text-slate-400 mt-1">Remodel</p>
                  </div>
                </div>
                <div class="col-span-3 text-slate-500 text-lg">Local</div>
                <div class="col-span-2 text-right text-slate-900 text-lg">$12,450</div>
                <div class="col-span-2 text-right text-slate-900 text-lg">$84,200</div>
              </div>

              <div
                class="grid grid-cols-12 gap-4 px-6 py-5 items-center hover:bg-slate-50/70 transition-colors border-b border-slate-100/80"
              >
                <div class="col-span-5 flex items-center gap-3">
                  <div
                    class="w-11 h-11 rounded-full bg-gradient-to-b from-blue-50 to-blue-100/60 border border-blue-200/50 flex items-center justify-center text-blue-600 shadow-[inset_0_2px_4px_rgba(255,255,255,0.9),0_2px_4px_rgba(0,0,0,0.04),inset_0_-1px_1px_rgba(0,0,0,0.05)]"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="w-5 h-5"
                    >
                      <path d="M10 2v2"></path>
                      <path d="M14 2v2"></path>
                      <path
                        d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <p class="text-slate-900 text-xl leading-none tracking-tight">Summit HVAC</p>
                  </div>
                </div>
                <div class="col-span-3 text-slate-500 text-lg">Metro</div>
                <div class="col-span-2 text-right text-slate-700 text-lg">$3,200</div>
                <div class="col-span-2 text-right text-slate-700 text-lg">$15,800</div>
              </div>

              <div
                class="grid grid-cols-12 gap-4 px-6 py-5 items-center hover:bg-slate-50/70 transition-colors border-b border-slate-100/80"
              >
                <div class="col-span-5 flex items-center gap-3">
                  <div
                    class="w-11 h-11 rounded-full bg-gradient-to-b from-emerald-50 to-emerald-100/60 border border-emerald-200/50 flex items-center justify-center text-emerald-600 shadow-[inset_0_2px_4px_rgba(255,255,255,0.9),0_2px_4px_rgba(0,0,0,0.04),inset_0_-1px_1px_rgba(0,0,0,0.05)]"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="w-5 h-5"
                    >
                      <path d="M14.4 14.4 9.6 9.6"></path>
                      <path
                        d="M18.657 21.485a2 2 0 1 1-2.829-2.828l-1.767 1.768a2 2 0 1 1-2.829-2.829l6.364-6.364a2 2 0 1 1 2.829 2.829l-1.768 1.767a2 2 0 1 1 2.828 2.829z"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <p class="text-slate-900 text-xl leading-none tracking-tight">Blue Ridge</p>
                  </div>
                </div>
                <div class="col-span-3 text-slate-500 text-lg">North</div>
                <div class="col-span-2 text-right text-slate-700 text-lg">$8,900</div>
                <div class="col-span-2 text-right text-slate-700 text-lg">$45,000</div>
              </div>

              <div class="grid grid-cols-12 gap-4 px-6 py-5 items-center hover:bg-slate-50/70 transition-colors">
                <div class="col-span-5 flex items-center gap-3">
                  <div
                    class="w-11 h-11 rounded-full bg-gradient-to-b from-purple-50 to-purple-100/60 border border-purple-200/50 flex items-center justify-center text-purple-600 shadow-[inset_0_2px_4px_rgba(255,255,255,0.9),0_2px_4px_rgba(0,0,0,0.04),inset_0_-1px_1px_rgba(0,0,0,0.05)]"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="w-5 h-5"
                    >
                      <path
                        d="M12 7.5a4.5 4.5 0 1 1 4.5 4.5M12 7.5A4.5 4.5 0 1 0 7.5 12M12 7.5V9m-4.5 3a4.5 4.5 0 1 0 4.5 4.5"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <p class="text-slate-900 text-xl leading-none tracking-tight">Harbor Homes</p>
                  </div>
                </div>
                <div class="col-span-3 text-slate-500 text-lg">Coastal</div>
