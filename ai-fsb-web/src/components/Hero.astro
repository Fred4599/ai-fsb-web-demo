              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { initHeroCanvas } from "../scripts/hero-canvas";
  import { initHeroReceiptChart } from "../scripts/hero-chart";

  initHeroCanvas();
  void initHeroReceiptChart("chart-starlight-hero");
</script>
