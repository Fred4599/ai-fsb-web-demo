                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
          </div>

          <div class="mb-2">
            <p class="text-[2.15rem] font-medium tracking-tight text-slate-900 leading-none drop-shadow-sm">
              $12,450.00
            </p>
            <div class="flex items-center gap-1.5 mt-2">
              <span
                class="flex items-center gap-1 text-xs font-medium text-emerald-700 bg-gradient-to-b from-emerald-50 to-emerald-100/50 px-1.5 py-0.5 rounded-md border border-emerald-200/50 shadow-[inset_0_1px_1px_rgba(255,255,255,0.9),0_1px_2px_rgba(0,0,0,0.04)]"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="10"
                  height="10"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline
                    points="16 7 22 7 22 13"></polyline></svg
                >
                14.2%
              </span>
              <span class="text-xs font-normal text-slate-400">vs last month</span>
            </div>
          </div>

          <div class="relative h-16 w-full mb-5 -ml-1">
            <canvas id="chart-starlight-hero"></canvas>
          </div>

          <div class="space-y-3 text-sm">
            <div
              class="flex justify-between items-center py-2.5 border-t border-slate-200/60 shadow-[inset_0_1px_0_rgba(255,255,255,0.5)]"
