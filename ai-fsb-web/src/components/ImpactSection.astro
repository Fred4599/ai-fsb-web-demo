---
---

<section
  id="impact-section"
  class="overflow-hidden bg-gradient-to-br from-white via-[#FAFAFA] to-[#F1F5F9] border-slate-200 border rounded-[1.5rem] sm:rounded-[2rem] lg:rounded-[3rem] mt-12 sm:mt-24 mr-3 sm:mr-6 mb-12 sm:mb-24 ml-3 sm:ml-6 pt-16 sm:pt-24 lg:pt-32 pb-16 sm:pb-24 lg:pb-32 relative shadow-sm"
>
  <div class="absolute inset-0 z-0 opacity-[0.03] pointer-events-none bg-pricing-grid"></div>

  <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none">
    <div class="absolute -top-1/2 -left-1/4 w-[150%] h-[150%] bg-[radial-gradient(circle_at_center,rgba(91,88,246,0.03)_0,transparent_50%)]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <h5 class="text-[#5B58F6] font-normal mb-8 tracking-widest uppercase text-xs flex items-center gap-3">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="w-5 h-5"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
        <path d="M2 12h20"></path>
      </svg>
      Measurable impact
    </h5>

    <div class="grid lg:grid-cols-2 gap-16 mb-24 items-center">
      <div class="">
        <h2 class="text-3xl sm:text-5xl lg:text-6xl font-light tracking-tight mb-8 text-slate-900 leading-tight font-serif">
          Outcomes you can <span class="italic text-[#5B58F6]">feel</span> in your calendar
        </h2>
        <p class="text-slate-500 text-xl leading-relaxed font-light max-w-[720px]">
          We help local businesses capture missed calls, grow reviews, and keep follow-up consistent—so the phone keeps
          ringing and your reputation stays strong.
        </p>
      </div>

      <div
        class="relative w-full max-w-[420px] aspect-square mx-auto lg:ml-auto flex items-center justify-center group cursor-default"
      >
        <div
          class="absolute inset-8 bg-[#5B58F6] opacity-[0.10] blur-[80px] rounded-full pointer-events-none transition-all duration-700 group-hover:opacity-[0.16]"
        >
        </div>

        <div
          class="relative w-full h-full rounded-full bg-white/70 backdrop-blur-2xl border border-white shadow-[0_10px_40px_rgba(15,23,42,0.04)] flex items-center justify-center p-7 transition-transform duration-500 group-hover:scale-[1.02]"
        >
          <div class="absolute inset-5 rounded-full border border-slate-200/80"></div>
          <div class="absolute inset-[3.3rem] rounded-full border border-slate-200/40"></div>

          <svg
            class="absolute inset-[1.75rem] w-[calc(100%-3.5rem)] h-[calc(100%-3.5rem)] -rotate-90"
            viewBox="0 0 240 240"
            aria-hidden="true"
          >
            <circle cx="120" cy="120" r="92" fill="none" stroke="#E2E8F0" stroke-width="1.25" opacity="0.75"></circle>
            <circle
              cx="120"
              cy="120"
              r="76"
              fill="none"
              stroke="#CBD5E1"
              stroke-width="7"
              stroke-linecap="round"
              stroke-dasharray="1 13.2"
              opacity="0.35"
            >
            </circle>
            <circle cx="120" cy="120" r="92" fill="none" stroke="#E9EEF5" stroke-width="10" stroke-linecap="round"></circle>
            <circle
              id="progress-ring"
              cx="120"
              cy="120"
              r="92"
              fill="none"
              stroke="url(#luminaProgressGradient)"
              stroke-width="10"
              stroke-linecap="round"
              stroke-dasharray="578"
              stroke-dashoffset="578"
              filter="url(#luminaGlow)"
            >
            </circle>
            <circle id="progress-dot" cx="120" cy="28" r="7.5" fill="#5B58F6" opacity="0" filter="url(#luminaGlow)"></circle>
            <defs>
              <linearGradient id="luminaProgressGradient" x1="20" y1="120" x2="220" y2="120" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#C7D2FE"></stop>
                <stop offset="55%" stop-color="#818CF8"></stop>
                <stop offset="100%" stop-color="#5B58F6"></stop>
              </linearGradient>
              <filter id="luminaGlow" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="4" result="blur"></feGaussianBlur>
                <feMerge>
                  <feMergeNode in="blur"></feMergeNode>
                  <feMergeNode in="SourceGraphic"></feMergeNode>
                </feMerge>
              </filter>
            </defs>
          </svg>

          <div
            class="absolute inset-[4.6rem] rounded-full bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.7),rgba(248,250,252,0.25))] border border-slate-100/80"
          >
          </div>

          <div
            class="relative w-40 h-40 rounded-full bg-gradient-to-b from-white to-slate-50 shadow-[0_18px_40px_-18px_rgba(15,23,42,0.18),inset_0_2px_8px_rgba(255,255,255,0.95)] border border-slate-100 flex flex-col items-center justify-center z-10"
          >
            <div class="flex items-start text-5xl font-light text-slate-900 tracking-tight font-serif leading-none ml-2">
              <span class="counter-value" data-target="84">0</span>
              <span class="text-2xl text-slate-400 font-light ml-1 mt-1">%</span>
            </div>
            <span class="mt-2 text-[10px] font-medium tracking-[0.22em] uppercase text-slate-400"> response rate </span>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-12 border-t border-slate-200 pt-10 sm:pt-16">
      <div class="">
        <div class="text-4xl sm:text-5xl lg:text-6xl font-light mb-4 tracking-tight text-slate-900 font-serif flex items-baseline">
          <span class="stat-counter" data-target="1200">0</span>
          <span class="text-3xl lg:text-4xl text-[#5B58F6] ml-1 font-light">+</span>
        </div>
        <p class="text-slate-500 text-xs font-normal tracking-widest uppercase">Conversations handled</p>
      </div>
      <div class="">
        <div class="text-4xl sm:text-5xl lg:text-6xl font-light mb-4 tracking-tight text-slate-900 font-serif flex items-baseline">
          <span class="stat-counter" data-target="99">0</span>
          <span class="text-3xl lg:text-4xl text-[#5B58F6] ml-1 font-light">%</span>
        </div>
        <p class="text-slate-500 text-xs font-normal tracking-widest uppercase">Client satisfaction</p>
      </div>
      <div class="">
        <div class="text-4xl sm:text-5xl lg:text-6xl font-light mb-4 tracking-tight text-slate-900 font-serif flex items-baseline">
          <span class="stat-counter" data-target="48">0</span>
          <span class="text-3xl lg:text-4xl text-[#5B58F6] ml-1 font-light">+</span>
        </div>
        <p class="text-slate-500 text-xs font-normal tracking-widest uppercase">Markets served</p>
      </div>
      <div>
        <div class="text-4xl sm:text-5xl lg:text-6xl font-light mb-4 tracking-tight text-slate-900 font-serif flex items-baseline">
          <span class="stat-counter" data-target="5">0</span>
        </div>
        <p class="text-slate-500 text-xs font-normal tracking-widest uppercase">Core automations</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { initImpactSection } from "../scripts/impact-section";
  initImpactSection();
</script>
