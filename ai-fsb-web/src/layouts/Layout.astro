---
import "../styles/global.css";
import { site } from "../content/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.shortName} — AI & automation for contractors`,
  description = `${site.name}: AI assistant, reviews, missed-call capture, and CRM—without tech headaches.`,
} = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.name,
  description,
  url: site.url,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&display=swap"
      rel="stylesheet"
    />
    <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js" defer></script>
    <script src="https://www.aura.build/FxFilter.js" defer></script>
  </head>
  <body
    class="antialiased selection:bg-[#EEF0FF] selection:text-[#5B58F6] overflow-x-hidden text-slate-600 bg-[#FAFAFA]"
  >
    <slot />
  </body>
</html>
